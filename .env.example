# ============================================================
#  .env.example — variables d'environnement du bot (A4)
#
#  Copier vers `.env` (IGNORÉ par git — ne JAMAIS committer de
#  vraies valeurs) puis remplir. Un canal d'alerte n'est activé
#  que si TOUTES ses variables sont présentes et non vides.
#  Le mode --live REFUSE de démarrer sans au moins un canal.
# ============================================================

# ── Webhook Discord/Slack (canal le plus simple) ──────────
SWINGBOT_WEBHOOK_URL=

# ── SMS Twilio ────────────────────────────────────────────
SWINGBOT_TWILIO_SID=
SWINGBOT_TWILIO_TOKEN=
SWINGBOT_TWILIO_FROM=
SWINGBOT_TWILIO_TO=

# ── Email SMTP ────────────────────────────────────────────
SWINGBOT_SMTP_URL=
SWINGBOT_SMTP_USER=
SWINGBOT_SMTP_PASS=
SWINGBOT_EMAIL_TO=
SWINGBOT_EMAIL_FROM=
