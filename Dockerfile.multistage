# ============================================================
#  Dockerfile  —  Multi-stage : build + tests + runtime
# ============================================================
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential cmake ninja-build git \
    curl zip unzip tar pkg-config \
    libssl-dev libcurl4-openssl-dev \
    sqlite3 libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# vcpkg
RUN git clone https://github.com/microsoft/vcpkg /vcpkg && \
    /vcpkg/bootstrap-vcpkg.sh -disableMetrics

RUN /vcpkg/vcpkg install \
    boost-beast boost-asio boost-system \
    nlohmann-json sqlite3 curl gtest

# ── Stage builder (compile tout) ──────────────────────────
FROM base AS builder

WORKDIR /app
COPY . .

# Release : le binaire qui trade doit être celui qui est testé (B2/B3) —
# les tests tournent DANS le build de l'image : un test rouge = pas d'image.
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/vcpkg/scripts/buildsystems/vcpkg.cmake \
    -G Ninja && \
    cmake --build build -j$(nproc) && \
    cd build && ctest --output-on-failure -j4

# ── Stage runtime (bot seul, image légère) ────────────────
FROM ubuntu:24.04 AS runtime

RUN apt-get update && apt-get install -y \
    libssl3 libcurl4 libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/build/swing_bot .
# Config prod externalisée (item 9.1) : le chemin est figé à la compilation
# (/app/config/prod.json) — sans ce fichier, le binaire refuse de démarrer.
COPY --from=builder /app/config/prod.json /app/config/prod.json
COPY --from=builder /vcpkg/installed/x64-linux/lib/*.so* /usr/local/lib/
RUN ldconfig

EXPOSE 9001

# Vivacité APPLICATIVE (item 17.3) : GET /healthz sur le port WsServer
# (bash /dev/tcp intégré, zéro dépendance — l'image n'a pas curl). Un 200
# prouve que la boucle d'événements répond et sert l'instantané de santé —
# au-delà de l'ancien test TCP pur qui ne voyait qu'un process gelé. Les
# SEUILS (âge du dernier cycle sain, dé-auth) restent à l'orchestrateur /
# opérateur : voir RUNBOOK §4-bis.
HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/9001 \
    && printf "GET /healthz HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n" >&3 \
    && head -1 <&3 | grep -q " 200 "' || exit 1

CMD ["./swing_bot"]
