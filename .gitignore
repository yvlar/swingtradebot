# ============================================================
#  .gitignore — SwingBot C++ + Python
# ============================================================

# ── Build C++ ─────────────────────────────────────────────
build/
cmake-build-debug/
cmake-build-release/
cmake-build-*/
build-*/
Testing/
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.gcda
*.gcno
*.gcov

# ── CMake ─────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
CMakeScripts/
_deps/
compile_commands.json
.cmake/

# ── CLion ─────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ── Base de données SQLite ────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── Logs ──────────────────────────────────────────────────
*.log
build_log*.txt

# ── Données CSV (trop lourdes pour git) ───────────────────
*.csv
!tests/**/*.csv
# Exceptions : jeux de données de référence du backtest/validation (versionnés
# car les goldens et le harnais multi-actifs en dépendent — items 17, 7.4).
!QQQ.csv
!SPY.csv
!IWM.csv
!MDY.csv
# Données longues total-return ~1999+ (dot-com/2008 inclus — item 8d.1) :
# versionnées car la confirmation du pullback (8d.3) et ses verrous OOS en
# dépendent. Export reproductible via scripts/export_total_return.py.
!QQQ_max.csv
!SPY_max.csv
!IWM_max.csv
!MDY_max.csv
# Indice de vol IMPLICITE ^VIX ~1990+ (Sprint 14, item 14.0) : versionné car les
# verrous OOS de la famille vix-regime en dépendent. SIGNAL de régime, jamais
# tradé ; Adj Close == Close (indice sans dividende).
!VIX_max.csv

# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
.env
.venv/
venv/

# ── Clés API — ne jamais committer ────────────────────────
.env
.env.*
!.env.example
secrets.yaml
config.local.*
*api_key*
*api_secret*

# ── Docker volumes locaux ─────────────────────────────────
.docker/

# ── Windows ───────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── macOS ─────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ── VSCode ────────────────────────────────────────────────
.vscode/
